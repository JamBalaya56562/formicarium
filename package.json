  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:build": "node --test tests/node/build.test.mjs",
    "test:runner": "node --test tests/node/runner.test.mjs",
    "test:probe": "node --test tests/node/probe.test.mjs",
    "test:aube": "node --test tests/node/aube-1645.test.mjs",
    "test:measure": "node --test tests/node/measure.test.mjs",
    "test:pitchfork": "node --test tests/node/pitchfork-basic.test.mjs",
    "test:browser": "playwright test tests/browser/probe.spec.mjs tests/browser/aube-1645.spec.mjs tests/browser/pitchfork-basic.spec.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "eslint": "10.12.0",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-coverage": "3.2.2"
  }
}
