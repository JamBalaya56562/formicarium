{
  "name": "@aletheia-works/formicarium",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "blink（x86-64 Linux ユーザーモードエミュレータ）を wasm 上で動かす PoC",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["runtime/public.mjs", "runtime/errors.mjs", "runtime/validation.mjs", "runtime/state.mjs", "runtime/lifecycle.mjs", "runtime/protocol.mjs", "runtime/worker-execution.mjs", "runtime/core.mjs", "runtime/guest-io.mjs", "runtime/node/api.mjs", "runtime/node/package-worker.mjs", "runtime/web/api.mjs", "runtime/web/package-worker.mjs", "types/", "assets/", "LICENSE", "THIRD_PARTY_NOTICES.md", "README.md"],
  "exports": {
    ".": {"types": "./types/index.d.ts", "import": "./runtime/public.mjs"},
