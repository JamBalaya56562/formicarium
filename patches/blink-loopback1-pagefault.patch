diff --git a/blink/machine.h b/blink/machine.h
index be17a8a..5298ef3 100644
--- a/blink/machine.h
+++ b/blink/machine.h
@@ -842,7 +842,8 @@ static inline u8 *FindHostPage(u64 entry) {
   if (HasLinearMapping()) {
     return (u8 *)(uintptr_t)(entry & PAGE_TA);
   } else {
-    return g_hostpages.p[(entry & PAGE_TA) >> 12];
+    return __atomic_load_n(&g_hostpages.p, __ATOMIC_ACQUIRE)
+        [(entry & PAGE_TA) >> 12];
   }
 }
 
diff --git a/blink/memory.c b/blink/memory.c
index 6c2d34c..31a38ca 100644
--- a/blink/memory.c
+++ b/blink/memory.c
@@ -103,7 +103,8 @@ u64 HandlePageFault(struct Machine *m, u8 *pslot, u64 entry) {
         m->system->memstat.reserved -= 1;
         entry = x;
       } else {
-        FreeAnonymousPage(m->system, (u8 *)(uintptr_t)(page & PAGE_TA));
+        // without a linear mapping, PAGE_TA holds a host page index
+        FreeAnonymousPage(m->system, FindHostPage(page));
         entry = LoadPte(pslot);
         m->system->rss -= 1;
       }
diff --git a/blink/memorymalloc.c b/blink/memorymalloc.c
index f7faa47..aeb43ee 100644
--- a/blink/memorymalloc.c
+++ b/blink/memorymalloc.c
@@ -54,6 +54,7 @@ struct Allocator {
 
 struct Machine g_bssmachine;
 struct HostPages g_hostpages;
+static pthread_mutex_t_ g_hostpages_lock = PTHREAD_MUTEX_INITIALIZER_;
 
 static void FillPage(void *p, int c) {
   memset(p, c, 4096);
@@ -76,14 +77,25 @@ static u64 TrackHostPage(u8 *ptr) {
   if (HasLinearMapping()) {
     return (uintptr_t)ptr;
   } else {
+    // threads fault pages in concurrently, and FindHostPage() reads the
+    // table without a lock, so a grown table is published by pointer and
+    // the old one is never freed while another thread may still read it
+    LOCK(&g_hostpages_lock);
     if (g_hostpages.n == g_hostpages.c) {
-      g_hostpages.c += 1;
-      g_hostpages.c += g_hostpages.c >> 1;
-      g_hostpages.p =
-          realloc(g_hostpages.p, g_hostpages.c * sizeof(*g_hostpages.p));
+      size_t c2;
+      u8 **p2;
+      c2 = g_hostpages.c + 1;
+      c2 += c2 >> 1;
+      unassert((p2 = (u8 **)malloc(c2 * sizeof(*p2))));
+      if (g_hostpages.n) {
+        memcpy(p2, g_hostpages.p, g_hostpages.n * sizeof(*p2));
+      }
+      __atomic_store_n(&g_hostpages.p, p2, __ATOMIC_RELEASE);
+      g_hostpages.c = c2;
     }
     entry = g_hostpages.n++;
     g_hostpages.p[entry] = ptr;
+    UNLOCK(&g_hostpages_lock);
     return entry << 12;
   }
 }
